  "namespaces": {
    "e2c": {
      "tasklocal": "e2c",
      "services": [
        "postgres",
        "valkey",
        "s3"
      ],
      "use": "consumer-local's API stages: INFRX_D_TASK=e2c (infrx-e2c-postgres, database infrx_e2c), INFRX_D2_VALKEY_PORT/_CONTAINER and INFRX_Q_VALKEY_PORT (the e2c Valkey port), INFRX_M_S3_ENDPOINT (infrx-e2c-s3, the MinIO pin the gate starts itself); ports from infrx/contracts/tasklocal.py"
    },
    "e2": {
      "harness": "e2",
      "postgrest": true,
      "use": "make integration / run.py layers 2-3 (consumer-local's integration-l3 stage) and certify.py's local stack; ports from tests/integration/harness.py (asserted against tasklocal's E block)"
    },
    "e2c-selftest": {
      "ports": [
        55510,
        55511,
        55512,
        55513,
        55514,
        55515,
        55516,
        55517,
        55518,
        55519
      ],
      "container_prefix": "infrx-e2c-selftest-",
      "use": "test_preflight.py binds 55510 to prove a busy port is BLOCKED; E2C lane block, no service"
    },
    "e4b": {
      "harness": "e4b",
      "postgrest": true,
      "use": "app-e2e's browser-journey stage: tests/integration/app/runner.py composes the E3C world as namespace e4b (harness offset +1300 -> 56800-56899; edge 56860, control 56861, App 56870 inside the block); it is also E4B's certify block (infrx/contracts/tasklocal.py), so E4B and the App journey never run at once; ports from tests/integration/harness.py"
    }
