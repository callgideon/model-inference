    "securitySchemes": {
      "ApiKeyAuth": {
        "bearerFormat": "sk-infrx",
        "description": "A consumer or provider-dev API key (`/v1/*`).",
        "scheme": "bearer",
        "type": "http"
      },
      "CheckpointSignature": {
        "description": "HMAC of the raw body by a LAB_CHECKPOINT_KEYS key.",
        "in": "header",
        "name": "X-Infrx-Signature",
        "type": "apiKey"
      },
      "OperatorKey": {
        "bearerFormat": "sk-infrx",
        "description": "An operator-audience API key.",
        "scheme": "bearer",
        "type": "http"
      },
      "SessionBearer": {
        "bearerFormat": "JWT",
        "description": "The signed-in user's Supabase session, forwarded by the web app's server; verified by the auth server.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
