[Unit]
Description=infrx gateway (pinned runtime image, 127.0.0.1:8001)
Requires=docker.service
After=docker.service network-online.target marlin2b-vllm.service infrx-valkey.service
Wants=network-online.target

[Service]
User=ubuntu
# The one configuration authority (preflight.py apply): systemd reads INFRX_IMAGE from it
# and the container reads the rest, so the image and the configuration it was probed
# with are replaced by the same rename. USAGE_LOG is in it too (row M-SCRATCH: on the
# root EBS volume, which survives a stop).
EnvironmentFile=/etc/marlin2b-gateway.env
ExecStartPre=-/usr/bin/docker rm -f infrx-gateway
# The media root R (PROCESSING_CACHE_DIR, one value for the gateway, the worker and the
# engine) is on the instance-store NVMe, which a stop/start wipes: recreate it with its
# owner every start rather than let docker create it root-owned. `+`: this one line runs
# privileged, the container does not. Group-writable (2770): the worker (10002, same group)
# prepares into it since PREP-WORKER.
ExecStartPre=+/usr/bin/install -d -o 10001 -g 10000 -m 2770 ${PROCESSING_CACHE_DIR}
# Least privilege: uid 10001 in group infrx, read-only root, no capabilities, bounded
# memory/CPU/pids (est. budgets, infra/README.md §2), loopback only - Caddy is the only
# public listener. The media root is writable by the gateway and the worker (preparation).
ExecStart=/usr/bin/docker run --rm --init --name infrx-gateway --network host \
  --user 10001:10000 --read-only --tmpfs /tmp:rw,size=1g,mode=1777 \
  --cap-drop ALL --security-opt no-new-privileges \
  --memory 8g --cpus 4 --pids-limit 512 \
  --env-file /etc/marlin2b-gateway.env \
  -v /var/lib/infrx/usage:/var/lib/infrx/usage \
  -v ${PROCESSING_CACHE_DIR}:${PROCESSING_CACHE_DIR} \
  ${INFRX_IMAGE} uvicorn --factory infrx.gateway.app:create_app --host 127.0.0.1 --port 8001 \
  --workers 1 \
  --timeout-graceful-shutdown 110
# Drain: uvicorn stops accepting and finishes in-flight requests for up to 110 s, docker
# waits 120 s before SIGKILL, and systemd waits longer than docker, because a systemd
# kill of the `docker run` client does not stop the container.
ExecStop=/usr/bin/docker stop -t 120 infrx-gateway
TimeoutStopSec=150
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
