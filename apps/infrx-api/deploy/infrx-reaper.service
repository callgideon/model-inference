[Unit]
Description=infrx reaper: one JobStore.recover() pass (requeue lost claims, fail lost publications)
Requires=docker.service
After=docker.service network-online.target infrx-valkey.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/marlin2b-gateway.env
ExecStartPre=-/usr/bin/docker rm -f infrx-reaper
# W2 request 7 / E3B request 4: nothing else calls `JobStore.recover()`. One pass per run;
# `python -m infrx.worker.reaper` is W3's entry point (the probe refuses a pilot image
# without it). Same identity as the worker, and no media access at all.
ExecStart=/usr/bin/docker run --rm --name infrx-reaper --network host \
  --user 10002:10000 --read-only --cap-drop ALL --security-opt no-new-privileges \
  --memory 512m --cpus 0.5 --pids-limit 64 \
  --env-file /etc/marlin2b-gateway.env \
  ${INFRX_IMAGE} python -m infrx.worker.reaper
TimeoutStartSec=120
# A timed-out oneshot is killed at the client; the container must not outlive it.
ExecStopPost=-/usr/bin/docker rm -f infrx-reaper
