# The only public listener (I2B.b). Caddy fetches and renews the certificate itself;
# ports 80 and 443 must be reachable and DNS must point here. `INFRX_SITE` exists for the
# local rehearsal (a plain-HTTP address, no ACME); the box leaves it unset.
{
	# The admin API can replace this whole site, and every runtime container shares the
	# host's loopback (--network host), so it is not on loopback: a unix socket in the
	# caddy_config volume, which only the Caddy container mounts. Reloads name it
	# (lib.sh caddy_reload).
	admin unix//config/admin.sock
}

{$INFRX_SITE:marlin2b.callbill.ai} {
	# Bounded bodies at the edge: 08 §5 MAX_REQUEST_BYTES = 100663296 (96 MiB).
	request_body {
		max_size 96MiB
	}
	handle_errors 413 {
		header Content-Type application/json
		respond `{"error":{"message":"The request body is too large.","type":"invalid_request_error","code":"request_too_large","param":null,"request_id":"{http.request.uuid}","infrx":null}}` 413
	}

	# The gateway down is "down" too, not an empty 502.
	handle_errors 502 503 504 {
		@health path /health
		handle @health {
			header Content-Type application/json
			respond `{"ok":false}` 503
		}
	}

	# A declared length over the bound is refused before a byte reaches the gateway (the
	# rehearsal found the gateway answering first otherwise); a chunked body is still cut
	# at max_size above.
	@oversized expression `{http.request.header.Content-Length}.size() > 0 && int({http.request.header.Content-Length}) > 100663296`
	handle @oversized {
		error 413
	}

	# Operator surfaces never leave the host: /metrics (I3B), /readyz (W3), /internal.
	# They answer on 127.0.0.1:8001 for the operator only. The engine (127.0.0.1:8000) has
	# no route here at all.
	@private path /metrics /metrics/* /readyz /readyz/* /internal /internal/*
	handle @private {
		header Content-Type application/json
		respond `{"error":{"message":"The requested resource was not found.","type":"not_found_error","code":"not_found","param":null,"request_id":"{http.request.uuid}","infrx":null}}` 404
	}

	# Public health says up or down and nothing else - no in-flight count, no upstream
	# error text - whatever the gateway's own body contains.
	handle /health {
		reverse_proxy 127.0.0.1:8001 {
			@up status 2xx
			handle_response @up {
				header Content-Type application/json
				respond `{"ok":true}` 200
			}
			handle_response {
				header Content-Type application/json
				respond `{"ok":false}` 503
			}
		}
	}

	# The metered API: chat, the jobs routes (G3) and the upload routes (G4U) since the
	# cutover mounted them. `flush_interval -1`: a stream (chat SSE, `/v1/jobs/{h}/events`)
	# is never buffered. No header directive anywhere: Location, Retry-After,
	# Preference-Applied, Idempotency-Replayed and Inference-Id reach the client as the
	# gateway sets them, and Last-Event-ID, Prefer and Idempotency-Key reach the gateway as
	# the client sent them.
	handle {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
			transport http {
				read_timeout 600s
			}
		}
	}
}
