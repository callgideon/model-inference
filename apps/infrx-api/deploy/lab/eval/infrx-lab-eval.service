[Unit]
Description=infrx Lab eval worker - B1 offline evaluation runs (the eval_run Lab outbox events) - OFF unless /etc/infrx-lab/eval.env exists
# I5 (LAB-WORKERS). Disabled by default: install.sh never writes the env file below, so the
# unit does not start (a skipped condition, not a failure) until an operator enables this one
# role (infra/lab/workers/eval/RUNBOOK.md). No Requires=/PartOf= on the consumer units, and
# none of them names this one: a Lab outage never stops, restarts or blocks inference.
ConditionPathExists=/etc/infrx-lab/eval.env
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# A crash loop stops after 5 starts in 10 minutes (no unbounded restart); leases expire and
# the next start recovers them.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=ubuntu
# Its own env file (mode 0600): LAB_DATABASE_URL (the transaction pooler, 6543), the role's
# concurrency and object-store names; never the gateway's /etc/marlin2b-gateway.env.
EnvironmentFile=/etc/infrx-lab/eval.env
ExecStartPre=-/usr/bin/docker rm -f infrx-lab-eval
# Resource bounds: memory, CPU (and a quarter of the default CPU weight, so inference wins
# contention), processes, a read-only root and a bounded tmpfs as its only scratch space.
# The entry point (WR-B-5, composition) exits 2 naming a missing setting, answers /readyz
# and /metrics on 127.0.0.1:8012, and drains on SIGTERM (unfinished leases expire and are
# recovered).
ExecStart=/usr/bin/docker run --rm --init --name infrx-lab-eval --network host \
  --user 10003:10000 --read-only --tmpfs /tmp:rw,size=256m,mode=1777 \
  --cap-drop ALL --security-opt no-new-privileges \
  --memory 1g --memory-swap 1g --cpus 1 --cpu-shares 256 --pids-limit 128 \
  --env-file /etc/infrx-lab/eval.env -e LAB_WORKER_HEALTH_PORT=8012 \
  ${INFRX_IMAGE} python -m infrx.lab.workers eval
ExecStop=/usr/bin/docker stop -t 60 infrx-lab-eval
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=mixed
Restart=on-failure
# 0-F5: exit 2 is a refusal (a missing setting, or a role with no work source yet, R198):
# final until the env file is fixed, never a restart loop. A pass that died (1) restarts.
RestartPreventExitStatus=2
RestartSec=10

[Install]
WantedBy=multi-user.target
