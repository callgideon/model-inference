[Unit]
Description=infrx Lab trace gauges - T3 loss, lag and retention numbers as a textfile - OFF unless /etc/infrx-lab/traces.env exists
# I2L-OBS (WR-T-5). Disabled by default (see infrx-lab-judge.service). Read-only against the
# trace stores: ClickHouse (loss, tombstones), PostgreSQL (the feedback outbox lag) and the
# spool directory's size. The textfile is evaluated against infra/lab/observe/alerts.json
# (WR-OBS-2); a failure writes `infrx_trace_gauges_up 0`, never silence.
ConditionPathExists=/etc/infrx-lab/traces.env
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/infrx-lab/traces.env
ExecStart=/usr/bin/docker run --rm --name infrx-lab-trace-gauges --network host \
  --user 10004:10000 --read-only --cap-drop ALL --security-opt no-new-privileges \
  --memory 256m --cpus 0.25 --cpu-shares 256 --pids-limit 32 \
  --env-file /etc/infrx-lab/traces.env \
  -v /opt/infrx/observe/infra/lab/observe:/observe:ro \
  -v ${TRACE_SPOOL_DIR}:/spool:ro -e TRACE_SPOOL_DIR=/spool \
  -v /var/lib/infrx/metrics:/m \
  ${INFRX_IMAGE} python /observe/trace_gauges.py --out /m/lab-traces.prom
TimeoutStartSec=60
