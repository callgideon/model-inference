[Unit]
Description=infrx Lab rollout controller - R2 guardrails and CAS rollback of controlled releases - OFF unless /etc/infrx-lab/rollout.env exists
# I7 (LAB-WORKERS, ROLLOUT-RECOVER). I6's shape (infra/lab/workers/training/RUNBOOK.md):
# disabled by default (install.sh never writes the env file below), no Requires=/PartOf= on a
# consumer unit and none of them names this one. Losing it never loses inference or
# accounting: admission reads D9's stored policy itself (R1, ROLLOUT_ROUTING off by default)
# and the controller never expands traffic on its own. Runbook:
# infra/lab/workers/rollout/RUNBOOK.md.
ConditionPathExists=/etc/infrx-lab/rollout.env
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=ubuntu
# Its own env file (ubuntu, 0600): the database, object store and allowlist only - no adapter,
# no budget, no cloud credential (the preflight refuses AWS_* and every adapter setting), so it
# cannot buy capacity; nothing is mounted, so it cannot start containers either.
EnvironmentFile=/etc/infrx-lab/rollout.env
ExecStartPre=/usr/bin/python3 /home/ubuntu/model-inference/infra/lab/workers/training/preflight.py --role rollout --env-file /etc/infrx-lab/rollout.env
ExecStartPre=-/usr/bin/docker rm -f infrx-lab-rollout
# One pass per interval over every running or rolled-back release (R2 Controller.step); a
# pass that cannot converge the alias exits non-zero and the restart below converges it.
# Egress denied as I6's (a dead proxy except LAB_EGRESS_ALLOW).
ExecStart=/usr/bin/docker run --rm --init --name infrx-lab-rollout --network host \
  --user 10003:10000 --read-only --tmpfs /tmp:rw,size=64m,mode=1777 \
  --cap-drop ALL --security-opt no-new-privileges \
  --memory 512m --memory-swap 512m --cpus 0.5 --cpu-shares 256 --pids-limit 64 \
  --env-file /etc/infrx-lab/rollout.env -e LAB_WORKER_HEALTH_PORT=8016 \
  -e HTTP_PROXY=http://127.0.0.1:9 -e http_proxy=http://127.0.0.1:9 \
  -e HTTPS_PROXY=http://127.0.0.1:9 -e https_proxy=http://127.0.0.1:9 \
  -e NO_PROXY=${LAB_EGRESS_ALLOW} -e no_proxy=${LAB_EGRESS_ALLOW} \
  ${INFRX_IMAGE} python -m infrx.lab.workers rollout
ExecStop=/usr/bin/docker stop -t 30 infrx-lab-rollout
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=mixed
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
