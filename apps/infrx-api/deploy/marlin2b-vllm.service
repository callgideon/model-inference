[Unit]
Description=vLLM serving Marlin-2B (docker, 127.0.0.1:8000; never public)
After=docker.service network-online.target
Requires=docker.service

[Service]
User=ubuntu
Environment=WEIGHTS_ROOT=/opt/dlami/nvme
Environment=HOME=/home/ubuntu
# One source per setting (W3): serve.sh reads ENGINE_MAX_NUM_SEQS and PROCESSING_CACHE_DIR
# under the names the runtime reads, from the same validated file, and refuses a second
# value on its command line - so this unit passes none. Its image pin, flags, loopback
# publish and read-only media mount are W3's; preflight.py checks them before a pilot.
EnvironmentFile=/etc/marlin2b-gateway.env
ExecStartPre=-/usr/bin/docker rm -f marlin2b-8000
ExecStartPre=+/usr/bin/install -d -o 10001 -g 10000 -m 2750 ${PROCESSING_CACHE_DIR}
ExecStart=/home/ubuntu/model-inference/models/marlin2b/serve.sh
# The box stopped this with docker's 10 s default (I1B inventory). The worker is drained
# first (it is ordered After= this unit, so it stops before it); systemd waits longer than
# docker, or it would kill only the client.
ExecStop=/usr/bin/docker stop -t 120 marlin2b-8000
TimeoutStopSec=150
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
