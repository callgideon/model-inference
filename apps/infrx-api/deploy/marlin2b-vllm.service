[Unit]
Description=vLLM serving Marlin-2B (docker, localhost:8000)
After=docker.service network-online.target
Requires=docker.service

[Service]
User=ubuntu
Environment=WEIGHTS_ROOT=/opt/dlami/nvme
Environment=HOME=/home/ubuntu
# serve.sh runs `docker run --rm` in the foreground, so systemd owns the lifecycle.
ExecStartPre=-/usr/bin/docker rm -f marlin2b-8000
ExecStart=/home/ubuntu/model-inference/models/marlin2b/serve.sh --max-num-seqs 32
ExecStop=/usr/bin/docker stop marlin2b-8000
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
