[Unit]
Description=infrx monitoring cycle: host and durable truth, alert rules, delivery (I8)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# P-25: ALERT_WEBHOOK_URL, ALERT_OWNER, ALERT_ESCALATION (root 0600). Optional so the cycle
# still records and evaluates without it; delivery then exits 3 (BLOCKED) and this unit is
# failed - visible in `systemctl --failed`, never a silent success.
EnvironmentFile=-/etc/infrx-alert.env
RuntimeDirectory=infrx-observe
RuntimeDirectoryMode=0700
ExecStart=/bin/bash /home/ubuntu/model-inference/infra/observe/observe.sh
TimeoutStartSec=120
