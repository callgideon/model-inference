[Unit]
Description=Valkey scheduling index (loopback only; rebuildable from PostgreSQL, no persistence)
Requires=docker.service
After=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f infrx-valkey
# Digest-pinned (the tests/integration/compose.yaml image, 8.1-alpine). No RDB/AOF: the
# index is rebuilt from PostgreSQL (DUR-OUTBOX), so a restart loses nothing durable.
# noeviction: a full index refuses writes instead of silently dropping candidates.
ExecStart=/usr/bin/docker run --rm --name infrx-valkey --network host \
  --user 999:1000 --read-only --cap-drop ALL --security-opt no-new-privileges \
  --memory 1g --cpus 1 --pids-limit 64 \
  valkey/valkey@sha256:d2e18f3410b6f616de1417f570fa55261af2898b9c5b2cfb6781ce2373ea43d1 \
  valkey-server --bind 127.0.0.1 --port 6379 --protected-mode yes \
  --save "" --appendonly no --maxmemory 768mb --maxmemory-policy noeviction
ExecStop=/usr/bin/docker stop -t 10 infrx-valkey
TimeoutStopSec=30
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
