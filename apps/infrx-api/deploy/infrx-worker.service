[Unit]
Description=infrx worker (claim -> engine -> journal; drains on stop)
Requires=docker.service
After=docker.service network-online.target marlin2b-vllm.service infrx-valkey.service
Wants=network-online.target
# W3: a stop or restart of the engine stops (drains) the worker first.
PartOf=marlin2b-vllm.service

[Service]
User=ubuntu
EnvironmentFile=/etc/marlin2b-gateway.env
# I8 slice 2: before every start, the installed env file is checked by the image that will
# read it (preflight.py envcheck: this image's env schema, no unknown or doubled name, every
# required key shaped, the runtime's own validation) - names only in the journal, the file
# over stdin, no network. A refusal fails the start: fail closed, never a silently ignored
# or stale setting. `$$` is systemd's literal `$`, expanded by sh from EnvironmentFile.
ExecStartPre=/bin/sh -c 'exec docker run --rm -i --network none "$$INFRX_IMAGE" python /app/deploy/preflight.py envcheck --mode "$$INFRX_MODE" --env-file /dev/stdin < /etc/marlin2b-gateway.env'
ExecStartPre=-/usr/bin/docker rm -f infrx-worker
# Its own uid (10002). PREP-WORKER: it prepares every job, so it writes the media root
# (PROCESSING_CACHE_DIR, mode 2770 for the shared group: the engine reads what it wrote).
# `python -m infrx.worker`: the composition root around W3's WorkerService, which also runs
# the store's recover() reaper (the probe refuses a pilot image without it). It refuses to
# start (exit 2, the setting named) without its stores, and answers /readyz, /livez and
# /metrics on 127.0.0.1:WORKER_HEALTH_PORT (8002: lib.sh wait_ready) once the pool, the
# bucket and the media root answered. --init: tini forwards SIGTERM, which starts the
# drain, and reaps children.
ExecStart=/usr/bin/docker run --rm --init --name infrx-worker --network host \
  --user 10002:10000 --read-only --tmpfs /tmp:rw,size=256m,mode=1777 \
  --cap-drop ALL --security-opt no-new-privileges \
  --memory 4g --cpus 2 --pids-limit 256 \
  --env-file /etc/marlin2b-gateway.env \
  -v ${PROCESSING_CACHE_DIR}:${PROCESSING_CACHE_DIR} \
  ${INFRX_IMAGE} python -m infrx.worker
# W3's drain: SIGTERM stops claiming, lets in-flight attempts finish within the deadline,
# then fences and releases the rest - a released job is requeued by the store, never lost
# (W2 limit 8). 330 s covers one full generation (08 §5 GENERATION_TIMEOUT_S = 300) plus
# margin; systemd waits longer than docker, or it would kill only the client.
ExecStop=/usr/bin/docker stop -t 330 infrx-worker
TimeoutStopSec=360
# W3's semantics for what follows a stop that outlived that budget: SIGTERM to the client
# first, SIGKILL to the rest of the unit only after it.
KillSignal=SIGTERM
KillMode=mixed
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
