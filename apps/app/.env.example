# Supabase project fcbnscgsymzdykendbrc. Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://fcbnscgsymzdykendbrc.supabase.co
# Publishable ("anon") key — safe in the browser, RLS does the work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by /admin actions. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Origin used to build the auth callback URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development-only fixture pages (never enabled in production, even when set).
# INFRX_CONSOLE_PREVIEW=1

# Server only (never NEXT_PUBLIC_): the public API origin, https with no path; Models/Docs show
# "unavailable" without it. Required in production (lib/deploy/env.ts, infra/app/README.md).
# INFRX_API_BASE_URL=
# Server only: signs usage/trace cursors, at least 16 characters. Required in production.
# CONSOLE_CURSOR_SECRET=
# `next start` outside Vercel must state its environment: production | preview | development.
# INFRX_APP_ENVIRONMENT=development
