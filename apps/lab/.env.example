# Lab (provider) app. Copy to .env.local. Its own origin; never the App's.
# Production: its own https origin, no path; otherwise every request is "unavailable".
NEXT_PUBLIC_LAB_URL=http://localhost:3100
# Server-only (never NEXT_PUBLIC_): lab-api's base URL (the Lab control service). It serves every family
# (control, traces, evaluations, pipelines, releases, datasets, judge) and, AP-09, the Lab shell: sign-in,
# refresh and sign-out (/auth/v1/*) and the memberships (/lab/v1/workspaces). Unset = the Lab is
# misconfigured and every page answers "unavailable". The credential is always the signed-in user's own
# session token; the Lab holds no Supabase URL, publishable key or service-role key.
LAB_API_URL=
# The Lab session cookies are infrx-lab-session and infrx-lab-refresh: http-only, host-only (never set a
# cookie Domain), SameSite=Lax, Secure on https. Email sign-in links return to
# <NEXT_PUBLIC_LAB_URL>/auth/callback (that origin must be in the API's WEB_ORIGINS).
# Development only: LAB_CONTROL_PREVIEW=1 shows an in-memory control stand-in (labelled); ignored in production.
# LAB_PIPELINES_PREVIEW=1  # dev only: in-memory pipelines stand-in; ignored in production
# LAB_EVALS_PREVIEW=1  # dev only: in-memory evaluations stand-in; ignored in production
# LAB_RELEASES_PREVIEW=1  # dev only: in-memory releases stand-in; ignored in production
