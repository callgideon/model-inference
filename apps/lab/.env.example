# Lab (provider) app. Copy to .env.local. Its own origin; never the App's.
# Production: its own https origin, no path; otherwise every request is "unavailable".
NEXT_PUBLIC_LAB_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
# Publishable ("anon") key; the session RPC public.lab_provider_memberships() (0030) decides what a
# session sees. The Lab holds no service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The Lab session cookie is sb-infrx-lab-auth: host-only (never set a cookie Domain), SameSite=Lax, Secure on https.
# Email sign-in links return to <NEXT_PUBLIC_LAB_URL>/auth/callback (add it to the Supabase redirect allow-list).
# Development only: LAB_CONTROL_PREVIEW=1 shows an in-memory control stand-in (labelled); ignored in production.
# LAB_PIPELINES_PREVIEW=1  # dev only: in-memory pipelines stand-in; ignored in production
# LAB_EVALS_PREVIEW=1  # dev only: in-memory evaluations stand-in; ignored in production
# LAB_RELEASES_PREVIEW=1  # dev only: in-memory releases stand-in; ignored in production
# Server-only (never NEXT_PUBLIC_): lab-api's base URL (the Lab control service, which serves every family:
# control, traces, evaluations, pipelines, releases, datasets). Unset = those pages read nothing and answer
# "unavailable". The credential is always the signed-in user's own session token.
LAB_API_URL=
# Deprecated fallbacks, read per family only while LAB_API_URL is unset (lib/auth/config.ts labApiUrl):
# LAB_CONTROL_URL, LAB_TRACES_API_URL, LAB_EVALS_API_URL, LAB_PIPELINES_API_URL, LAB_RELEASES_API_URL,
# LAB_DATASETS_API_URL. Set LAB_API_URL instead.
